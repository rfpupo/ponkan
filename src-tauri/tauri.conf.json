{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ponkan",
  "mainBinaryName": "ponkan",
  "version": "0.3.0",
  "identifier": "app.ponkan.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "pon//kan.",
        "width": 1060,
        "height": 600,
        "minWidth": 1060,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "maxWidth": 1060,
        "maxHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:1420 ws://localhost:1420 ipc: http://ipc.localhost data: blob:",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' http://localhost:1420",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://localhost:1420",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 data: blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "VALORANT profile manager",
    "longDescription": "Save, manage, share and restore VALORANT settings profiles.",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "PortugueseBR",
          "Spanish"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "./release-hooks.nsh",
        "template": "./release-installer.nsi"
      }
    },
    "resources": {
      "../LICENSE-THIRD-PARTY.txt": "LICENSE-THIRD-PARTY.txt",
      "../third-party-notices/": "third-party-notices/",
      "../LICENSE": "LICENSE"
    }
  }
}
